---
import '../styles/global.css';
import SiteChrome from '../components/layout/SiteChrome';
import Footer from '../components/layout/Footer.astro';
import { BRAND } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  /** Pages with an edge-to-edge hero opt out of the default top padding. */
  bleed?: boolean;
  ogImage?: string;
}

const {
  title = `${BRAND.name} — ${BRAND.tagline}`,
  description = 'Skincare original con envíos a todo el país. K-beauty, rutinas personalizadas y asesoría real. Valangel Skin — made to glow.',
  bleed = false,
  ogImage = 'https://images.unsplash.com/photo-1631729371254-42c2892f0e6e?auto=format&fit=crop&w=1200&q=80',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://valangelskin.com').toString();
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F5DADF" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_VE" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`.replace('//', '/')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Montserrat:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen flex flex-col bg-white">
    <SiteChrome client:load pathname={pathname} />

    <!-- Offset for the fixed announcement bar + header -->
    <main class={`flex-1 w-full ${bleed ? 'pt-[104px] lg:pt-[108px]' : 'pt-[132px] lg:pt-[148px]'}`}>
      <slot />
    </main>

    <Footer />

    <!-- Clears the mobile tab bar so nothing sits under it -->
    <div class="h-14 sm:hidden pb-safe" aria-hidden="true"></div>
  </body>
</html>
