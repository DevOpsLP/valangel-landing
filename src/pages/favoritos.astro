---
import Layout from '../layouts/Layout.astro';
import WishlistBrowser from '../components/shop/WishlistBrowser';
---

<Layout
  title="Mis favoritos | Valangel Skin"
  description="Los productos que guardaste para después en Valangel Skin."
>
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 py-8 sm:py-12">
    <header class="mb-8">
      <p class="eyebrow">Tu lista</p>
      <h1 class="display text-4xl sm:text-5xl mt-2">Mis favoritos</h1>
      <p class="mt-3 text-sm text-muted max-w-md leading-relaxed">
        Se guardan en este dispositivo, así que estarán aquí la próxima vez que vuelvas.
      </p>
    </header>

    <WishlistBrowser client:load />
  </div>
</Layout>
