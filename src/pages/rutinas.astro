---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import RoutineQuiz from '../components/shop/RoutineQuiz';
import { concerns, unsplash, PHOTO } from '../lib/catalog';
import { ConcernIcon } from '../components/ui/icons';
import { u } from '../lib/url';
import { WA_LINK } from '../lib/constants';
---

<Layout
  title="Crea tu rutina | Valangel Skin"
  description="Responde cuatro preguntas y te armamos una rutina de skincare a tu medida, con productos que tenemos en stock."
  bleed
>
  <PageHero
    eyebrow="Tu rutina a tu medida"
    title="Crea tu<br />rutina"
    text="Cuatro preguntas, un minuto. Te recomendamos los productos ideales según lo que tu piel necesita hoy — y puedes agregar la rutina completa de una sola vez."
    tone="rose"
  />

  <section class="w-full bg-white py-12 sm:py-16" aria-label="Test de rutina">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <RoutineQuiz client:load />
    </div>
  </section>

  <!-- ── Browse by concern ──────────────────────────────────────────── -->
  <section class="w-full grad-cream py-12 sm:py-16" aria-labelledby="necesidades-title">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 id="necesidades-title" class="display text-3xl sm:text-4xl">¿Prefieres ir directo al grano?</h2>
      <p class="mt-3 text-sm text-muted max-w-lg leading-relaxed">
        Filtra la tienda por lo que más te preocupa ahora mismo.
      </p>

      <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {concerns.map((c) => (
          <li>
            <a
              href={u(`/tienda?necesidad=${c.slug}`)}
              class="group flex flex-col gap-2 h-full bg-white border border-line rounded-2xl p-5 hover:border-taupe transition-colors"
            >
              <span class="w-7 h-7 text-taupe"><ConcernIcon name={c.icon} /></span>
              <span class="text-[15px] text-ink group-hover:text-wine transition-colors">{c.name}</span>
              <span class="text-[11px] text-muted leading-snug">{c.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Advisor CTA ────────────────────────────────────────────────── -->
  <section class="w-full bg-white py-12 sm:py-16">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid md:grid-cols-2 rounded-3xl overflow-hidden border border-line">
        <div class="p-8 sm:p-10 flex flex-col justify-center gap-4">
          <p class="eyebrow">¿Dudas con tu piel?</p>
          <h2 class="display text-3xl sm:text-4xl">Habla con una asesora real</h2>
          <p class="text-sm text-muted leading-relaxed max-w-sm">
            Cuéntanos qué usas hoy y qué te gustaría mejorar. Te respondemos con una recomendación honesta,
            aunque la respuesta sea "no necesitas comprar nada más".
          </p>
          <a href={WA_LINK} target="_blank" rel="noreferrer" class="btn btn-primary self-start mt-2">
            Escribir por WhatsApp
          </a>
        </div>
        <img
          src={unsplash(PHOTO.handDropper, 900, 700)}
          alt="Asesoría personalizada de skincare"
          loading="lazy"
          class="w-full h-full object-cover min-h-[220px]"
        />
      </div>
    </div>
  </section>
</Layout>
