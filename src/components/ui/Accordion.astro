---
interface Props {
  items: Array<{ q: string; a: string }>;
  id?: string;
}
const { items, id } = Astro.props;
---

<!-- Native <details> keeps this keyboard-accessible and JS-free -->
<div id={id} class="divide-y divide-line border-y border-line">
  {items.map((item) => (
    <details class="group">
      <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <span class="text-[15px] text-ink leading-snug pr-2">{item.q}</span>
        <span class="mt-1 w-5 h-5 shrink-0 grid place-items-center text-taupe transition-transform duration-300 group-open:rotate-45">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </summary>
      <p class="pb-5 -mt-1 text-sm text-muted leading-relaxed max-w-2xl">{item.a}</p>
    </details>
  ))}
</div>
