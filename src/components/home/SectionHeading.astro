---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Stacked layout puts the copy above the content instead of beside it. */
  stacked?: boolean;
}
import { u } from '../../lib/url';
const { eyebrow, title, text, ctaLabel, ctaHref, stacked = false } = Astro.props;
---

<div class:list={['flex flex-col', stacked ? 'items-start gap-3' : 'gap-3 lg:max-w-[220px] shrink-0']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="display text-3xl sm:text-4xl lg:text-[2.75rem] leading-[0.95]" set:html={title} />
  {text && <p class="text-sm text-muted leading-relaxed max-w-xs">{text}</p>}
  {ctaLabel && ctaHref && (
    <a href={u(ctaHref)} class="btn btn-primary self-start mt-2">
      {ctaLabel}
      <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  )}
</div>
