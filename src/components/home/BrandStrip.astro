---
import { brands } from '../../lib/catalog';
import { u } from '../../lib/url';
---

<section class="w-full bg-white border-y border-line" aria-labelledby="marcas-title">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 py-6 sm:py-8">
    <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-10">
      <h2 id="marcas-title" class="display text-xl sm:text-2xl shrink-0 leading-none">
        Nuestras<br class="hidden lg:block" /> marcas
      </h2>

      <span class="hidden lg:block w-px h-10 bg-line shrink-0" aria-hidden="true"></span>

      <div class="rail gap-7 sm:gap-10 flex-1 items-center">
        {brands.map((b) => (
          <a
            href={u(`/marcas/${b.slug}`)}
            class="shrink-0 text-muted hover:text-wine transition-colors whitespace-nowrap"
          >
            <span class="font-[family-name:var(--font-display)] text-base sm:text-lg tracking-wide">
              {b.name}
            </span>
          </a>
        ))}
        <a
          href={u('/marcas')}
          class="shrink-0 w-9 h-9 grid place-items-center rounded-full border border-line text-wine hover:bg-rose-light transition-colors"
          aria-label="Ver todas las marcas"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
