# ─── impoven-cms (Strapi v5) ──────────────────────────────────────────────────
# Base URL of the CMS. Leave unset for local development against a CMS on :1337.
PUBLIC_STRAPI_URL=https://cms.impoven.com

# Read token, only if the collections are not public.
PUBLIC_STRAPI_TOKEN=

# ─── Contact ──────────────────────────────────────────────────────────────────
# WhatsApp number in international format, digits only (country code + number).
PUBLIC_WA_NUMBER=584124113978

# ─── Google Maps ──────────────────────────────────────────────────────────────
# Enables the address picker in checkout. Without it, checkout falls back to a
# plain address textarea — the flow still works end to end.
# Restrict the key by HTTP referrer before shipping it.
PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Deployment ───────────────────────────────────────────────────────────────
# Only needed when the site is served from a sub-path (GitHub Pages project
# sites). CI sets this automatically; leave it unset locally.
# PUBLIC_BASE_PATH=/valangel-landing/
# PUBLIC_SITE_URL=https://devopslp.github.io
